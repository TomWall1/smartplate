{
  "expo": {
    "name": "Deal to Dish",
    "slug": "deals-to-dish",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4EEE2"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.smartplate.dealstodish",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#36453B"
      },
      "package": "com.smartplate.dealstodish"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "dealstodish",
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.640522418425-tfaproeomt5mbjp95r9feafn2keml9b2"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://deals-to-dish-api.onrender.com",
      "googleWebClientId": "640522418425-vtcdniju3q84hjjfbc7eilk9s9t7c762.apps.googleusercontent.com",
      "googleIosClientId": "640522418425-tfaproeomt5mbjp95r9feafn2keml9b2.apps.googleusercontent.com",
      "revenueCatIosKey": "TODO_REVENUECAT_IOS_PUBLIC_KEY",
      "revenueCatAndroidKey": "TODO_REVENUECAT_ANDROID_PUBLIC_KEY",
      "revenueCatEntitlementId": "premium",
      "eas": {
        "projectId": "1dff3ebb-5978-4dd4-a7d2-f5068aa631b4"
      }
    },
    "owner": "wallto"
  }
}
